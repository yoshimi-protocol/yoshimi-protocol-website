---
import BaseLayout from '../layouts/BaseLayout.astro';
import referencesRaw from '../content/references.md?raw';

const [protocol] = await Astro.glob('../content/protocol.md');
const tocItems = protocol
  .getHeadings()
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ title: heading.text, id: heading.slug }));

const tocEntries = [...tocItems, { title: 'References', id: 'references' }];
const references = referencesRaw
  .split(/\n\s*\n/)
  .map((block) => block.trim())
  .filter(Boolean)
  .map((block) => {
    const merged = block.replace(/\s*\n\s*/g, ' ');
    const cleaned = merged.replace(/^[\s\d\u00B9\u00B2\u00B3\u2070-\u2079]+/, '').trim();
    const html = cleaned.replace(/https?:\/\/[^\s—]+/g, (url) =>
      `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`
    );

    return { html };
  });
---

<BaseLayout title="The Yoshimi Protocol - Full Text" description="Read the full Yoshimi Protocol document.">
  <section class="section-padding">
    <div class="container-xl" style="display: grid; gap: 2rem;">
      <div>
        <p class="eyebrow">Protocol document</p>
        <h1 class="display" style="font-size: clamp(2.6rem, 5vw, 4rem); margin: 0 0 1rem;">
          The Yoshimi Protocol
        </h1>
        <p style="max-width: 42rem; color: var(--color-muted);">
          A long-form framework for ethical AI development, ratified by the community and maintained in public.
        </p>
      </div>

      <div class="protocol-grid">
        <details class="toc-panel" id="toc-panel">
          <summary class="toc-summary">Table of contents</summary>
          <nav aria-label="Table of contents">
            <ul class="toc-list">
              {tocEntries.map((item) => (
                <li>
                  <a href={`#${item.id}`} data-toc={item.id}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
        <article class="prose">
          <protocol.Content />
          <hr />
          <details class="references-panel" id="references-panel">
            <summary class="references-summary" id="references">References</summary>
            <div class="references-content">
              <ol class="references-list">
                {references.map((reference) => (
                  <li set:html={reference.html} />
                ))}
              </ol>
            </div>
          </details>
        </article>
      </div>
    </div>
  </section>

  <script is:inline>
    const tocLinks = Array.from(document.querySelectorAll('[data-toc]'));
    const tocPanel = document.getElementById('toc-panel');
    const headingIds = tocLinks.map((link) => link.getAttribute('data-toc'));
    const headings = headingIds
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    if (tocPanel) {
      const referencesPanel = document.getElementById('references-panel');

      tocLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (link.getAttribute('data-toc') === 'references' && referencesPanel) {
            referencesPanel.setAttribute('open', '');
          }
          tocPanel.removeAttribute('open');
        });
      });
    }

    if (headings.length) {
      const setActive = (id) => {
        tocLinks.forEach((link) => {
          link.classList.toggle('active', link.getAttribute('data-toc') === id);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
            }
          });
        },
        { rootMargin: '-30% 0px -60% 0px', threshold: 0.1 }
      );

      headings.forEach((heading) => observer.observe(heading));
      setActive(headings[0].id);
    }
  </script>
</BaseLayout>
